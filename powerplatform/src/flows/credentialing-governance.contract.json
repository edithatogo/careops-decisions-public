{
  "name": "Credentialing governance and delegated decision",
  "contractVersion": "0.1.0",
  "status": "blueprint-disabled-by-default",
  "capabilityPack": "credentialing-governance",
  "featureFlag": "decisions_EnableCredentialingGovernance",
  "decisionAuthority": "deployment-defined-human-delegate",
  "steps": [
    {
      "id": "receive-governance-packet",
      "type": "versioned-contract-intake",
      "sourceContract": "careops-approve-credentialing-governance-packet-0.1.0",
      "required": [
        "requestId",
        "practitionerReference",
        "pathwayCode",
        "requestedScopeReferences",
        "facilityOrServiceReferences",
        "templateVersion",
        "authorityMappingVersion",
        "evidenceManifestReference",
        "verificationSummaryReference",
        "proceduralFairnessStatus",
        "sourcePacketHash"
      ]
    },
    {
      "id": "verify-packet",
      "type": "schema-version-and-hash-check",
      "onFailure": "register-visible-exception-and-return-to-source"
    },
    {
      "id": "resolve-governance-context",
      "type": "configuration-and-authority-resolution",
      "requires": [
        "current-governance-body",
        "current-terms-of-reference",
        "membership",
        "quorum-rule",
        "relevant-peer-rule",
        "conflict-rule",
        "current-delegated-decision-role",
        "current-authority-reference"
      ],
      "onFailure": "block-consideration-with-visible-exception"
    },
    {
      "id": "check-case-readiness",
      "type": "deterministic-readiness-validation",
      "checks": [
        "packet-integrity",
        "mandatory-evidence-references",
        "professional-review-requirements",
        "service-capability-attestation",
        "procedural-fairness-state",
        "temporary-pathway-controls-if-applicable"
      ],
      "onFailure": "return-through-controlled-correction-path"
    },
    {
      "id": "schedule-consideration",
      "type": "meeting-and-agenda-registration",
      "requires": [
        "meetingId",
        "agendaItemId",
        "classification",
        "case-access-list"
      ]
    },
    {
      "id": "confirm-quorum-and-conflicts",
      "type": "mandatory-human-and-deterministic-gate",
      "requires": [
        "attendance-record",
        "voting-eligibility",
        "relevant-peer-presence-or-approved-equivalent",
        "conflict-declarations",
        "recusal-evidence",
        "quorum-evidence-reference"
      ],
      "onFailure": "defer-consideration-and-record-reason"
    },
    {
      "id": "run-optional-ai-draft",
      "type": "approved-ai-drafting-assistance",
      "enabledByFeatureFlag": "decisions_EnableCredentialingAiDrafts",
      "allowedOutputs": [
        "case-summary-draft",
        "minutes-draft",
        "recommendation-wording-draft",
        "decision-wording-draft",
        "missing-reason-or-date-flags",
        "action-drafts"
      ],
      "authoritative": false,
      "requiresSourceReferences": true,
      "requiresModelPromptAndRunProvenance": true,
      "onFailure": "continue-with-human-process"
    },
    {
      "id": "committee-deliberation",
      "type": "human-governance-process",
      "records": [
        "questions-and-further-information",
        "material-considered",
        "conflict-and-recusal-actions",
        "deliberation-summary",
        "proposed-outcome",
        "proposed-reasons",
        "proposed-conditions",
        "proposed-supervision",
        "recommended-commencement-and-expiry"
      ]
    },
    {
      "id": "confirm-procedural-fairness",
      "type": "deployment-defined-human-gate",
      "when": "outcome-may-be-adverse-or-new-adverse-material-considered",
      "requires": [
        "notice-reference",
        "response-opportunity",
        "response-status",
        "response-consideration-evidence"
      ],
      "onFailure": "block-final-recommendation-or-decision"
    },
    {
      "id": "record-human-recommendation",
      "type": "committee-recommendation",
      "requires": [
        "recommendationId",
        "confirmedByReference",
        "confirmedAt",
        "outcomeCode",
        "recommendedScopeReferences",
        "reasons",
        "sourceMinutesReference",
        "recordHash"
      ],
      "aiCannotConfirm": true,
      "doesNotCreateDecision": true
    },
    {
      "id": "route-to-current-delegate",
      "type": "authority-validated-human-task",
      "requires": [
        "decisionMakerReference",
        "delegationAuthorityReference",
        "recommendationReference",
        "case-and-evidence-access"
      ],
      "onFailure": "block-decision-and-escalate-to-governance-owner"
    },
    {
      "id": "record-human-delegated-decision",
      "type": "separate-decision-record",
      "requires": [
        "decisionId",
        "decisionMakerReference",
        "delegationAuthorityReference",
        "humanDecisionConfirmed",
        "outcomeCode",
        "approvedScopeReferences",
        "reasons",
        "conditionsOrSupervisionReferences",
        "commencementDate",
        "expiryDate",
        "decidedAt",
        "recordHash"
      ],
      "automaticDecisionPermitted": false,
      "aiCannotDecide": true
    },
    {
      "id": "draft-and-approve-communication",
      "type": "human-reviewed-correspondence",
      "mayUseAiDraft": true,
      "requires": [
        "decision-reference",
        "reasons",
        "scope-conditions-and-dates",
        "review-or-appeal-information-where-applicable",
        "human-communication-approval"
      ]
    },
    {
      "id": "return-result-references",
      "type": "immutable-outbound-contract",
      "targetContract": "careops-decisions-credentialing-result-0.1.0",
      "contains": [
        "requestId",
        "recommendationId",
        "decisionId",
        "delegationAuthorityReference",
        "outcomeCode",
        "approvedScopeReferences",
        "conditionReferences",
        "supervisionPlanReference",
        "commencementDate",
        "expiryDate",
        "communicationReference",
        "decisionHash"
      ],
      "doesNotReplaceAuthoritativeRegister": true
    },
    {
      "id": "create-actions-and-review-dates",
      "type": "governance-follow-up",
      "mayInclude": [
        "condition-monitoring",
        "supervision-review",
        "temporary-approval-retrospective-review",
        "renewal-reminder",
        "cross-organisation-notification",
        "review-or-appeal-due-date"
      ]
    },
    {
      "id": "emit-process-events",
      "type": "privacy-minimised-event-projection",
      "enabledByFeatureFlag": "decisions_EnableCredentialingProcessEvents",
      "targetContract": "careops-process-credentialing-events-0.1.0",
      "rawDocuments": false,
      "sensitiveFreeText": false
    },
    {
      "id": "finalize-governance-record",
      "type": "audit-persistence",
      "requires": [
        "packet-hash",
        "minutes-reference",
        "recommendation-hash",
        "decision-hash",
        "communication-status",
        "integration-status",
        "review-and-appeal-status"
      ]
    }
  ],
  "failurePaths": [
    "invalid-packet-is-visible-and-returned",
    "missing-authority-blocks-consideration-or-decision",
    "missing-quorum-or-relevant-peer-defers-consideration",
    "conflict-without-recusal-blocks-participation",
    "adverse-path-without-fairness-blocks-finalisation",
    "recommendation-never-auto-creates-decision",
    "ai-output-never-confirms-recommendation-or-decision",
    "ai-failure-preserves-human-process",
    "missing-delegate-blocks-decision",
    "failed-outbound-handoff-preserves-decision-and-creates-reconciliation-exception",
    "temporary-pathway-without-hard-expiry-is-rejected"
  ],
  "deploymentConfiguration": "Committee, terms of reference, quorum, peer rules, delegations, authorities, durations, records locations, integrations, and identities are deployment-specific and excluded from source control."
}
