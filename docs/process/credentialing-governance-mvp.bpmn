<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CredentialingGovernance" targetNamespace="https://github.com/edithatogo/careops-decisions-public">
  <bpmn:process id="Process_CredentialingGovernanceMvp" name="Credentialing governance MVP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Packet" name="Governance packet received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidatePacket" name="Validate version, schema and hash">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PacketValid" name="Packet valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Correction" name="Return through controlled correction path">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Returned" name="Returned for correction">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ResolveContext" name="Resolve current governance and authority context">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ContextReady" name="Current context complete?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GovernanceException" name="Create visible governance exception">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Blocked" name="Blocked pending governance resolution">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Schedule" name="Schedule committee consideration">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MeetingReady" name="Quorum, peer and conflict controls satisfied?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Defer" name="Defer and record reason">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Deferred" name="Deferred">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Deliberation" name="Human committee deliberation">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FairnessRequired" name="Procedural fairness required?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Fairness" name="Complete procedural fairness">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Recommendation" name="Record human committee recommendation">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Delegate" name="Route to current delegate">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DelegateValid" name="Authority and human decision confirmed?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Decision" name="Record separate delegated decision">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Communication" name="Approve decision communication">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Result" name="Return immutable result references">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Actions" name="Create conditions and review actions">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Events" name="Emit privacy-minimised process events">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Finalise" name="Finalise governance record">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Result" name="Decision reference available; register and release remain separate">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Packet" targetRef="Task_ValidatePacket" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ValidatePacket" targetRef="Gateway_PacketValid" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="Gateway_PacketValid" targetRef="Task_ResolveContext" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="Gateway_PacketValid" targetRef="Task_Correction" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Correction" targetRef="EndEvent_Returned" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ResolveContext" targetRef="Gateway_ContextReady" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Gateway_ContextReady" targetRef="Task_Schedule" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="Gateway_ContextReady" targetRef="Task_GovernanceException" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_GovernanceException" targetRef="EndEvent_Blocked" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Schedule" targetRef="Gateway_MeetingReady" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_MeetingReady" targetRef="Task_Deliberation" />
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_MeetingReady" targetRef="Task_Defer" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Defer" targetRef="EndEvent_Deferred" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Deliberation" targetRef="Gateway_FairnessRequired" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_FairnessRequired" targetRef="Task_Recommendation" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="Gateway_FairnessRequired" targetRef="Task_Fairness" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Fairness" targetRef="Task_Recommendation" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Recommendation" targetRef="Task_Delegate" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Delegate" targetRef="Gateway_DelegateValid" />
    <bpmn:sequenceFlow id="Flow_20" name="Yes" sourceRef="Gateway_DelegateValid" targetRef="Task_Decision" />
    <bpmn:sequenceFlow id="Flow_21" name="No" sourceRef="Gateway_DelegateValid" targetRef="Task_GovernanceException" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Decision" targetRef="Task_Communication" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Communication" targetRef="Task_Result" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Result" targetRef="Task_Actions" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Actions" targetRef="Task_Events" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Events" targetRef="Task_Finalise" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Finalise" targetRef="EndEvent_Result" />
  </bpmn:process>
</bpmn:definitions>
